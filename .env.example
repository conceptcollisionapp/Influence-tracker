# Influence Tracker — environment variables
#
# FEC API key. The app falls back to DEMO_KEY (heavily rate-limited).
# Get a free key instantly at https://api.open.fec.gov/developers/
FEC_API_KEY=DEMO_KEY

# SEC EDGAR requires a descriptive User-Agent identifying your app + contact.
# https://www.sec.gov/os/webmaster-faq#developers
SEC_USER_AGENT="InfluenceTracker/1.0 (contact@example.com)"
